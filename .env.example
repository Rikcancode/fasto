WITHINGS_CLIENT_ID=your_client_id_here
WITHINGS_CLIENT_SECRET=your_client_secret_here
WITHINGS_REDIRECT_URI=http://192.168.68.74:3007/api/withings/callback
PORT=80
HOST=0.0.0.0
# Basic auth for the dashboard and API. Leave FASTO_PASSWORD empty to run unprotected (not recommended).
FASTO_USER=fasto
FASTO_PASSWORD=change_me
# TRMNL e-ink display (optional). Webhook URL from your TRMNL private plugin; see trmnl/README.md.
TRMNL_WEBHOOK_URL=
TRMNL_PUSH_MINUTES=30
# Token a self-hosted TRMNL server (LaraPaper) sends to read /api/trmnl/poll. Generate with: openssl rand -hex 16
TRMNL_POLL_TOKEN=
TZ=Europe/Rome
