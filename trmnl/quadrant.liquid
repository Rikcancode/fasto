<div class="layout layout--col layout--stretch-x gap--small">
  <span class="label">Weight · 7-day</span>
  <span class="value value--xlarge lg:value--xxlarge fasto-nowrap">{{ weight.avg7 | default: "--" }}<span class="fasto-unit">kg</span></span>
  <span class="description">{{ weight.delta }} · fat {{ fat.avg7 | default: "--" }} %</span>
  <div class="progress-bar progress-bar--small">
    <div class="content">
      <span class="label label--small">Goal {{ weight.target }} kg</span>
      <span class="value value--xxsmall">{{ weight.progressPct | default: 0 }}%</span>
    </div>
    <div class="track"><div class="fill" style="width: {{ weight.progressPct | default: 0 }}%"></div></div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Fasto</span>
  <span class="instance">{{ updated }}</span>
</div>
