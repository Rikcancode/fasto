{% comment %} Zen Dots for the numbers, DM Sans for everything else. {% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,600&family=Zen+Dots&display=block" rel="stylesheet">
<style>
  .view, .view *, .title_bar, .title_bar * { font-family: 'DM Sans', sans-serif !important; }
  .view .value, .view .value * { font-family: 'Zen Dots', sans-serif !important; font-weight: 400 !important; letter-spacing: -0.02em; }
  .view .value .fasto-unit { font-family: 'DM Sans', sans-serif !important; font-weight: 600 !important; margin-right: 0.2em; }
  .view .value--mega, .view .value--xxlarge { zoom: 0.64; margin-right: 40px; }
  .fasto-prog { display: flex; flex-direction: column; gap: 6px; }
  .fasto-prog__head, .fasto-prog__foot { display: flex; justify-content: space-between; align-items: baseline; }
  .fasto-prog__track { position: relative; height: 34px; border: 3px solid #000; border-radius: 17px; overflow: hidden; background: #fff; }
  .fasto-prog__fill { position: absolute; left: 0; top: 0; bottom: 0; background: #000; }
  .fasto-prog__tick { position: absolute; top: 6px; bottom: 6px; width: 3px; background: #888; transform: translateX(-50%); }
  .fasto-prog__plan { position: absolute; top: -3px; bottom: -3px; width: 6px; background: #000; transform: translateX(-50%); box-shadow: 0 0 0 3px #fff; }
  .fasto-hero__head { display: flex; justify-content: space-between; }
  .fasto-hero { display: flex; align-items: center; gap: 10px; }
  .fasto-hero .value--mega, .fasto-hero .value--xxlarge { margin-right: 0 !important; }
  .fasto-hero .fasto-goal { font-size: 50px !important; line-height: 1 !important; }
  .fasto-chevrons { flex: 1 1 auto; min-width: 0; display: flex; justify-content: center; gap: 3px; }
  .fasto-chev { height: 40px; width: 22px; flex: 0 1 22px; min-width: 8px; fill: #fff; stroke: #000; stroke-width: 4; stroke-linejoin: miter; }
  .fasto-chev--done { fill: #000; }
  .fasto-status { display: flex; align-items: center; gap: 16px; }
</style>
<style>
  .fasto-chart { position: relative; flex: 1 1 auto; min-height: 0; }
  .fasto-chart svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .fasto-chart .actual { fill: none; stroke: #000; stroke-width: 4; stroke-linejoin: round; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .fasto-chart .plan { fill: none; stroke: #777; stroke-width: 2; stroke-dasharray: 10 8; vector-effect: non-scaling-stroke; }
  .fasto-chart .grid { stroke: #bbb; stroke-width: 1; vector-effect: non-scaling-stroke; }
  .fasto-col { display: flex; flex-direction: column; align-items: stretch; align-self: stretch; min-width: 0; gap: var(--gap-small, 7px); }
  .fasto-col--spaced { justify-content: space-between; }
  .fasto-axis { display: flex; justify-content: space-between; gap: 1em; }
  .progress-bar .content { justify-content: space-between; gap: 0.5em; }
  .fasto-unit { font-size: 0.4em; line-height: 1; margin-left: 0.15em; }
  .fasto-nowrap { white-space: nowrap; }
  .title_bar .fasto-logo { height: 52px !important; width: 52px !important; max-height: none !important; margin: 0 2px 0 -6px; flex: 0 0 auto; }
  .fasto-goals { background: #000; color: #fff; border-radius: 12px; padding: 14px 18px; display: flex; flex-direction: column; gap: 4px; }
  .fasto-goals .title, .fasto-goals .description, .fasto-goals .label { color: #fff; }
  .fasto-journey { display: flex; flex-direction: column; border: 3px solid #000; border-radius: 12px; overflow: hidden; }
  .fasto-step { display: grid; grid-template-columns: minmax(0,1fr) auto auto; align-items: center; gap: 18px; padding: 2px 16px; border-top: 2px solid #bbb; }
  .fasto-step:first-child { border-top: 0; }
  .fasto-step .label { flex: 1 1 auto; white-space: nowrap; }
  .fasto-step .description { white-space: nowrap; }
  .fasto-step .fasto-when { text-align: right; }
  .fasto-step .value { text-align: right; min-width: 2.6em; white-space: nowrap; }
  .fasto-step--now { background: #000; }
  .fasto-step--now .label, .fasto-step--now .value, .fasto-step--now .description { color: #fff; }
  .fasto-stats { display: flex; gap: 48px; }
  .fasto-stat { display: flex; align-items: baseline; gap: 14px; white-space: nowrap; }
  .fasto-plan { display: flex; flex-direction: column; min-height: 0; gap: 6px; }
  .fasto-plan__head { display: flex; justify-content: space-between; }
  .fasto-plan__area { position: relative; flex: 1 1 auto; min-height: 60px; margin: 40px 14px 0 14px; }
  .fasto-plan__area svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .fasto-plan__past { position: absolute; top: 0; bottom: 0; left: 0; background: #e4e4e4; }
  .fasto-plan .plan { fill: none; stroke: #000; stroke-width: 3; stroke-dasharray: 12 9; vector-effect: non-scaling-stroke; }
  .fasto-plan .actual { fill: none; stroke: #000; stroke-width: 6; stroke-linejoin: round; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .fasto-plan .grid { stroke: #ccc; stroke-width: 1; vector-effect: non-scaling-stroke; }
  .fasto-plan .today { stroke: #000; stroke-width: 3; vector-effect: non-scaling-stroke; }
  .fasto-dot { position: absolute; border-radius: 50%; transform: translate(-50%, -50%); box-sizing: border-box; }
  .fasto-dot--ms { width: 16px; height: 16px; background: #fff; border: 3px solid #000; }
  .fasto-dot--goal { width: 26px; height: 26px; background: #000; border: 4px solid #000; }
  .fasto-dot--now { width: 30px; height: 30px; background: #000; border: 5px solid #fff; box-shadow: 0 0 0 3px #000; }
  .fasto-today { position: absolute; top: 0; transform: translate(-50%, -100%); font-size: 18px; font-weight: 700; background: #000; color: #fff; padding: 2px 8px; border-radius: 6px; white-space: nowrap; }
  .fasto-today--start { transform: translate(-14px, -100%); }
  .fasto-today--end { transform: translate(calc(-100% + 14px), -100%); }
  .fasto-ms-label { position: absolute; transform: translate(-50%, -150%); font-size: 18px; line-height: 1; white-space: nowrap; }
  .fasto-plan__axis { position: relative; height: 1.6em; margin: 0 14px; }
  .fasto-plan__axis .label { position: absolute; top: 0; white-space: nowrap; }
  .fasto-plan__axis .fasto-tick { transform: translateX(-50%); }
  .fasto-plan__axis .fasto-tick--end { transform: translateX(-100%); }
</style>
{% capture fasto_logo %}<svg class="fasto-logo" viewBox="0 0 128 128" aria-hidden="true"><image href="data:image/png;base64," width="128" height="128"/></svg>{% endcapture %}
{% comment %} Time for new goals once the target is reached, the goal date has passed, or no goal is set. {% endcomment %}
{% assign new_goals = false %}
{% if weight.target == nil %}
  {% assign new_goals = true %}{% assign goals_reason = "No goal is set yet." %}
{% elsif weight.toGo == 0 %}
  {% assign new_goals = true %}{% capture goals_reason %}You reached {{ weight.target }} kg.{% endcapture %}
{% elsif weight.weeksLeft == 0 %}
  {% assign new_goals = true %}{% capture goals_reason %}The goal date, {{ weight.targetDate }}, has passed.{% endcapture %}
{% endif %}

