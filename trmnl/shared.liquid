<style>
  .fasto-chart { position: relative; flex: 1 1 auto; min-height: 0; }
  .fasto-chart svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .fasto-chart .actual { fill: none; stroke: #000; stroke-width: 4; stroke-linejoin: round; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .fasto-chart .plan { fill: none; stroke: #777; stroke-width: 2; stroke-dasharray: 10 8; vector-effect: non-scaling-stroke; }
  .fasto-chart .grid { stroke: #bbb; stroke-width: 1; vector-effect: non-scaling-stroke; }
  .fasto-col { display: flex; flex-direction: column; align-items: stretch; align-self: stretch; min-width: 0; gap: var(--gap-small, 7px); }
  .fasto-col--spaced { justify-content: space-between; }
  .fasto-axis { display: flex; justify-content: space-between; gap: 1em; }
  .progress-bar .content { justify-content: space-between; gap: 0.5em; }
  .fasto-unit { font-size: 0.4em; line-height: 1; margin-left: 0.15em; }
  .fasto-nowrap { white-space: nowrap; }
  .title_bar .fasto-logo { height: 52px !important; width: 52px !important; max-height: none !important; margin: 0 2px 0 -6px; flex: 0 0 auto; }
  .fasto-face { width: 64px; height: 64px; flex: 0 0 auto; margin-left: 8px; }
  .screen--lg .fasto-face { width: 92px; height: 92px; }
  .fasto-face--small { width: 40px; height: 40px; }
  .screen--lg .fasto-face--small { width: 56px; height: 56px; }
  .fasto-goals { background: #000; color: #fff; border-radius: 12px; padding: 14px 18px; display: flex; flex-direction: column; gap: 4px; }
  .fasto-goals .title, .fasto-goals .description, .fasto-goals .label { color: #fff; }
  .fasto-journey { display: flex; flex-direction: column; border: 3px solid #000; border-radius: 12px; overflow: hidden; }
  .fasto-step { display: grid; grid-template-columns: minmax(0,1fr) auto auto; align-items: center; gap: 18px; padding: 10px 16px; border-top: 2px solid #bbb; }
  .fasto-step:first-child { border-top: 0; }
  .fasto-step .label { flex: 1 1 auto; white-space: nowrap; }
  .fasto-step .description { white-space: nowrap; }
  .fasto-step .fasto-when { text-align: right; }
  .fasto-step .value { text-align: right; min-width: 2.6em; white-space: nowrap; }
  .fasto-step--now { background: #000; }
  .fasto-step--now .label, .fasto-step--now .value, .fasto-step--now .description { color: #fff; }
  .fasto-dir { display: inline-flex; align-items: center; gap: 10px; border-radius: 10px; padding: 6px 14px; border: 3px solid #000; }
  .fasto-dir--bad { background: #000; }
  .fasto-dir--bad .title, .fasto-dir--bad .label, .fasto-dir--bad svg { color: #fff; fill: #fff; }
  .fasto-dir svg { width: 40px; height: 40px; flex: 0 0 auto; }
</style>
{% capture fasto_logo %}<svg class="fasto-logo" viewBox="0 0 128 128" aria-hidden="true"><image href="data:image/png;base64," width="128" height="128"/></svg>{% endcapture %}
{% comment %} Plan status drives the face: behind the plan line is sad, on it or ahead is happy. {% endcomment %}
{% capture fasto_face %}{% if weight.deltaState == "behind" %}<svg class="fasto-face" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="45" fill="#fff" stroke="#000" stroke-width="6"/><circle cx="34" cy="40" r="6"/><circle cx="66" cy="40" r="6"/><path d="M30 74 Q50 56 70 74" fill="none" stroke="#000" stroke-width="6" stroke-linecap="round"/><path d="M27 52 q-5 9 0 13 q5 -4 0 -13z" fill="#777"/></svg>{% elsif weight.deltaState == "ahead" or weight.deltaState == "on-track" %}<svg class="fasto-face" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="45" fill="#fff" stroke="#000" stroke-width="6"/><circle cx="34" cy="40" r="6"/><circle cx="66" cy="40" r="6"/><path d="M28 60 Q50 82 72 60" fill="none" stroke="#000" stroke-width="6" stroke-linecap="round"/></svg>{% endif %}{% endcapture %}
{% comment %} Time for new goals once the target is reached, the goal date has passed, or no goal is set. {% endcomment %}
{% assign new_goals = false %}
{% if weight.target == nil %}
  {% assign new_goals = true %}{% assign goals_reason = "No goal is set yet." %}
{% elsif weight.toGo == 0 %}
  {% assign new_goals = true %}{% capture goals_reason %}You reached {{ weight.target }} kg.{% endcapture %}
{% elsif weight.weeksLeft == 0 %}
  {% assign new_goals = true %}{% capture goals_reason %}The goal date, {{ weight.targetDate }}, has passed.{% endcapture %}
{% endif %}

{% comment %} Direction since the programme started: towards the goal is right, away from it is wrong. {% endcomment %}
{% assign dir_state = "none" %}
{% if weight.start and weight.avg7 and weight.target %}
  {% assign dir_change = weight.avg7 | minus: weight.start | round: 1 %}
  {% assign dir_abs = dir_change | abs %}
  {% assign goal_down = false %}{% if weight.target < weight.start %}{% assign goal_down = true %}{% endif %}
  {% if dir_abs < 0.1 %}
    {% assign dir_state = "flat" %}{% assign dir_text = "No change" %}
  {% elsif dir_change < 0 %}
    {% capture dir_text %}{{ dir_abs }} kg down{% endcapture %}
    {% if goal_down %}{% assign dir_state = "good" %}{% else %}{% assign dir_state = "bad" %}{% endif %}
  {% else %}
    {% capture dir_text %}{{ dir_abs }} kg up{% endcapture %}
    {% if goal_down %}{% assign dir_state = "bad" %}{% else %}{% assign dir_state = "good" %}{% endif %}
  {% endif %}
{% endif %}
{% capture dir_arrow %}{% if dir_change < 0 %}<svg viewBox="0 0 40 40" aria-hidden="true"><path d="M20 36 L4 18 H14 V4 H26 V18 H36 Z"/></svg>{% elsif dir_state == "flat" %}<svg viewBox="0 0 40 40" aria-hidden="true"><path d="M36 20 L18 4 V14 H4 V26 H18 V36 Z"/></svg>{% else %}<svg viewBox="0 0 40 40" aria-hidden="true"><path d="M20 4 L36 22 H26 V36 H14 V22 H4 Z"/></svg>{% endif %}{% endcapture %}
{% capture fasto_dir %}{% if dir_state != "none" %}<div class="fasto-dir{% if dir_state == "bad" %} fasto-dir--bad{% endif %}">{{ dir_arrow }}<span class="title">{{ dir_text }} since {{ weight.startDate | default: "start" }} · {% if dir_state == "good" %}right direction{% elsif dir_state == "bad" %}wrong direction{% else %}holding{% endif %}</span></div>{% endif %}{% endcapture %}
